---
interface Props {
  n: number;
  title: string;
}
const { n, title } = Astro.props;
---

<div class="step" data-reveal>
  <span class="step__n">{String(n).padStart(2, '0')}</span>
  <span class="step__rule" aria-hidden="true"></span>
  <h3 class="step__title">{title}</h3>
  <p class="body"><slot /></p>
</div>

<style>
  .step { display: flex; flex-direction: column; gap: 16px; }
  .step__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.03em;
  }
  .step__n { align-self: flex-start; transform-origin: 20% 80%; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .step:hover .step__n { animation: jiggle 0.7s var(--ease-out); }
  }
  .step__rule { height: 1px; background: var(--border-dark); }
  .step__title { font-size: 20px; font-weight: 700; line-height: 1.3; }
</style>
