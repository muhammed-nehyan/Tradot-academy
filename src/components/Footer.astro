---
import { site, navLinks, legalLinks, whatsappLink, addressLines, mapDirectionsUrl, logoSrc } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer bg-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" aria-label="Tradot Academy home">
          <img src={logoSrc} alt="Tradot Academy" width="320" height="182" loading="lazy" />
        </a>
        <p class="body">Practical stock market education with a focus on discipline and risk management.</p>
      </div>

      <div class="footer__cols">
        <div>
          <h2 class="label footer__head">Quick links</h2>
          <ul role="list">
            {navLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="label footer__head">Legal</h2>
          <ul role="list">
            {legalLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="label footer__head">Contact</h2>
          <ul role="list">
            <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
            <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp us</a></li>
            <li>
              <a href={mapDirectionsUrl} target="_blank" rel="noopener" class="footer__address">
                {addressLines.map((l) => <span>{l}</span>)}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <p class="footer__disclaimer"><strong>Disclaimer:</strong> {site.disclaimer}</p>

    <div class="footer__bottom">
      <span>© {year} {site.name}. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 56px 0 28px; }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }
  .footer__brand { max-width: 320px; }
  .footer__brand img { width: 160px; height: auto; margin-bottom: 20px; }

  .footer__cols { display: flex; gap: 80px; }
  .footer__head { color: var(--on-dark); margin-bottom: 18px; }
  .footer__cols li { margin-bottom: 10px; }
  .footer__cols a,
  .footer__cols span { color: var(--on-dark-muted); font-size: 15px; transition: color 0.2s; }
  .footer__cols a:hover { color: var(--accent); }
  .footer__cols .footer__address { display: flex; flex-direction: column; line-height: 1.6; }
  .footer__cols .footer__address span { color: inherit; }

  .footer__disclaimer {
    margin-top: 40px;
    padding: 18px 24px;
    background: var(--ink-raised);
    border: 1px solid var(--border-dark);
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--on-dark-muted);
  }
  .footer__disclaimer strong { color: var(--on-dark); font-weight: 600; }

  .footer__bottom {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-dark);
    font-size: 14px;
    color: var(--on-dark-muted);
  }

  @media (max-width: 1000px) {
    .footer { padding: 64px 0 32px; }
    .footer__top { flex-direction: column; gap: 40px; }
    .footer__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .footer__cols > :last-child { grid-column: 1 / -1; }
  }
</style>
