---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
interface Props {
  icon: IconName;
  title: string;
}
const { icon, title } = Astro.props;
---

<div class="feature" data-reveal>
  <span class="feature__badge"><Icon name={icon} /></span>
  <h3 class="feature__title">{title}</h3>
  <p class="body"><slot /></p>
</div>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  :global(.bg-dark) .feature { border-color: var(--border-dark); }
  .feature__badge {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--cyan-soft);
    color: var(--accent);
  }
  :global(.bg-dark) .feature__badge { background: rgba(0, 184, 212, 0.12); }
  .feature__title { font-size: 19px; font-weight: 700; line-height: 1.3; }
</style>
