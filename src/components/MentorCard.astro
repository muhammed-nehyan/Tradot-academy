---
interface Props {
  name: string;
  role: string;
  photo?: string;
}
const { name, role, photo } = Astro.props;
---

<article class="mentor" data-reveal>
  <div class="mentor__photo" data-img-reveal>
    {photo ? <img src={photo} alt={name} loading="lazy" /> : <span class="label">Photo coming soon</span>}
  </div>
  <p class="label mentor__role">{role}</p>
  <h3 class="mentor__name">{name}</h3>
  <p class="body"><slot /></p>
</article>

<style>
  .mentor { display: flex; flex-direction: column; gap: 10px; }
  .mentor__photo {
    aspect-ratio: 4 / 5;
    margin-bottom: 10px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #E6ECEF;
    color: var(--muted);
  }
  :global(.bg-dark) .mentor__photo { background: var(--ink-raised); color: var(--on-dark-muted); }
  .mentor__photo img { width: 100%; height: 100%; object-fit: cover; }
  .mentor__role { color: var(--accent); }
  .mentor__name { font-size: var(--fs-card); font-weight: 700; line-height: 1.3; }
</style>
