---
// Shared shell for Privacy, Terms and Disclaimer.
import Base from './Base.astro';
import { legalLinks } from '../data/site';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
---

<Base title={title} description={description}>
  <header class="legal-hero bg-dark">
    <div class="container">
      <p class="eyebrow">Legal</p>
      <h1 class="h1">{title}</h1>
      <p class="label legal-hero__updated">Last updated {updated}</p>
    </div>
  </header>

  <section class="bg-white legal">
    <div class="container legal__grid">
      <nav class="legal__nav" aria-label="Legal pages">
        {
          legalLinks.map((l) => (
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <article class="prose">
        <slot />
      </article>
    </div>
  </section>
</Base>

<style>
  .legal-hero { padding: calc(var(--nav-h) + 72px) 0 72px; }
  .legal-hero .container { display: flex; flex-direction: column; gap: 16px; }
  .legal-hero__updated { color: var(--on-dark-muted); }

  .legal { padding: 80px 0 120px; }
  .legal__grid { display: grid; grid-template-columns: 220px minmax(0, 760px); gap: 80px; }
  .legal__nav { display: flex; flex-direction: column; gap: 12px; position: sticky; top: calc(var(--nav-h) + 32px); align-self: start; }
  .legal__nav a { color: var(--muted); font-weight: 600; }
  .legal__nav a:hover, .legal__nav a[aria-current='page'] { color: var(--text); }
  .legal__nav a[aria-current='page'] { box-shadow: inset 2px 0 0 var(--cyan); padding-left: 12px; }

  .prose { font-size: 16px; line-height: 1.75; color: var(--muted); }
  .prose :global(h2) { margin: 48px 0 14px; font-size: 22px; line-height: 1.3; color: var(--text); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(ul) { margin-bottom: 16px; }
  .prose :global(ul) { padding-left: 22px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: var(--cyan); text-underline-offset: 3px; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(.callout) {
    padding: 20px 24px;
    border-left: 3px solid var(--cyan);
    background: var(--subtle);
    border-radius: 0 12px 12px 0;
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 1000px) {
    .legal-hero { padding: calc(var(--nav-h) + 40px) 0 48px; }
    .legal { padding: 48px 0 80px; }
    .legal__grid { grid-template-columns: 1fr; gap: 32px; }
    .legal__nav { position: static; flex-direction: row; flex-wrap: wrap; gap: 8px 20px; }
    .legal__nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--cyan); padding-left: 0; }
  }
</style>
