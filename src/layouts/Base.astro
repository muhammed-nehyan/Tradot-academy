---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/800-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/tokens.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep out of search results (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description = 'Learn stock market trading from basics to advance level at Tradot Academy, Kalamassery, Kochi. 25-day program with live sessions from day 1, online and offline.',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Stock Market Trading Classes in Kochi`;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: site.name,
  url: Astro.site?.href,
  logo: new URL('/logo.png', Astro.site).href,
  telephone: site.phoneDisplay.replace(/\s/g, ''),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kalamassery, Kochi',
    addressRegion: 'Kerala',
    addressCountry: 'IN',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1117" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="cursor" data-cursor aria-hidden="true"></div>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {
      Astro.slots.has('cta') ? (
        <div class="last-screen">
          <div class="last-screen__cta">
            <div class="container">
              <slot name="cta" />
            </div>
          </div>
          <Footer />
        </div>
      ) : (
        <Footer />
      )
    }

    <a
      class="wa-float"
      href={whatsappLink('Hi Tradot Academy, I would like to know more about the trading course.')}
      target="_blank"
      rel="noopener"
      aria-label="Chat with us on WhatsApp"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.43 9.43 0 0 1-4.8-1.32l-.35-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.24-9.44 9.45-9.44 2.52 0 4.89.99 6.67 2.77a9.37 9.37 0 0 1 2.76 6.68c0 5.21-4.24 9.44-9.44 9.44m8.04-17.48A11.3 11.3 0 0 0 12.05.7C5.78.7.68 5.8.68 12.06c0 2 .52 3.96 1.52 5.68L.58 23.62l6.03-1.58a11.33 11.33 0 0 0 5.43 1.38h.01c6.27 0 11.37-5.1 11.37-11.37 0-3.04-1.18-5.89-3.33-8.04"
        ></path>
      </svg>
    </a>

    <script>
      import '../scripts/motion';
      import '../scripts/animations';
    </script>
  </body>
</html>

<style>
  /* Last screen = CTA band + footer together. */
  .last-screen { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; }
  .last-screen__cta { flex: 1; display: flex; align-items: center; padding: 48px 0; background: var(--subtle); }
  .last-screen__cta > .container { width: min(var(--container), 100% - 2 * var(--gutter)); }
  @media (max-width: 1000px) {
    .last-screen { min-height: 0; }
  }

  .wa-float {
    position: fixed;
    right: 32px;
    bottom: 32px;
    z-index: 40;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--whatsapp);
    color: #fff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s var(--ease-out);
  }
  .wa-float:not(.is-magnetic):hover { transform: scale(1.06); }
  .wa-float.is-magnetic { transition: none; }
  .wa-float::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--whatsapp);
    opacity: 0;
    pointer-events: none;
  }
  @keyframes wa-nudge {
    0%, 86%, 100% { transform: rotate(0); }
    88% { transform: rotate(-16deg) scale(1.1); }
    90% { transform: rotate(14deg) scale(1.1); }
    92% { transform: rotate(-10deg); }
    94% { transform: rotate(6deg); }
    96% { transform: rotate(-3deg); }
  }
  @keyframes wa-pulse {
    0%, 70% { transform: scale(1); opacity: 0; }
    72% { opacity: 0.7; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .wa-float svg { animation: wa-nudge 7s ease-in-out 3s infinite; }
    .wa-float::after { animation: wa-pulse 7s ease-out 3s infinite; }
    .wa-float:hover svg { animation: jiggle 0.7s var(--ease-out); }
  }

  @media (max-width: 1000px) {
    .wa-float { right: 16px; bottom: 16px; width: 54px; height: 54px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float, .wa-float:hover { transition: none; transform: none; }
    .wa-float svg, .wa-float::after { animation: none; }
  }
</style>
