---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import NewsCard from '../components/NewsCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getNews, formatNewsTime, NEWS_ATTRIBUTION, type NewsSource } from '../data/news';

const news = await getNews();
const sources: ('All' | NewsSource)[] = ['All', 'Moneycontrol', 'Investing.com'];

// Top 6 per filter: render cards for each source's first 6 so filtering never leaves gaps.
const top = new Set<string>();
for (const s of sources) {
  news
    .filter((n) => s === 'All' || n.source === s)
    .slice(0, 6)
    .forEach((n) => top.add(n.link));
}
const updated = formatNewsTime(new Date());
---

<Base
  title="Market News"
  description="Latest Indian stock market headlines from Moneycontrol and Investing.com, updated through the day. For information only, not investment advice."
>
  <section class="screen screen--hero bg-dark news-page" data-news>
    <div class="container">
      <div class="news-head">
        <div class="news-head__text">
          <p class="eyebrow">Market news</p>
          <h1 class="h1" data-split>Headlines that <em>move markets.</em></h1>
        </div>
        <div class="news-head__side">
          <p class="lead">The latest market headlines from Moneycontrol and Investing.com. Updated {updated} IST.</p>
          <div class="chips" role="group" aria-label="Filter by source">
            {
              sources.map((s, i) => (
                <button class="chip" type="button" data-filter={s} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {s}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      {
        news.length ? (
          <div class="grid-3 news-top" data-news-top>
            {news.map((item) => top.has(item.link) && <NewsCard item={item} as="h2" />)}
          </div>
        ) : (
          <p class="news-empty">News unavailable right now. Please check back soon.</p>
        )
      }
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="screen bg-white">
        <div class="container more">
          <div class="more__head">
            <p class="eyebrow">More headlines</p>
            <h2 class="h2" data-split>
              Everything <em>else.</em>
            </h2>
            <p class="attribution">{NEWS_ATTRIBUTION}</p>
          </div>
          <ol class="more__list" role="list" data-news-list>
            {news.map((n) => (
              <li data-source={n.source}>
                <a href={n.link} target="_blank" rel="noopener nofollow">
                  <span class="label more__src">{n.source}</span>
                  <span class="more__title">{n.title}</span>
                  {n.date && <time datetime={n.date.toISOString()}>{formatNewsTime(n.date)}</time>}
                  <Icon name="arrowUpRight" size={18} />
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {news.length === 0 && (
    <section class="bg-white attribution-only">
      <div class="container"><p class="attribution">{NEWS_ATTRIBUTION}</p></div>
    </section>
  )}

  <CtaBand slot="cta">Learn to read the <em>market yourself.</em></CtaBand>
</Base>

<script>
  // Source filter. Top cards: first 6 matching; list: all matching.
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-news]');
    if (!root) return;
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-news-top] [data-source]');
    const rows = document.querySelectorAll<HTMLElement>('[data-news-list] [data-source]');

    const apply = (filter: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
      let shown = 0;
      cards.forEach((c) => {
        const match = filter === 'All' || c.dataset.source === filter;
        const show = match && shown < 6;
        if (show) shown++;
        c.hidden = !show;
        if (show) c.style.removeProperty('visibility'), c.style.removeProperty('opacity');
      });
      rows.forEach((r) => (r.hidden = !(filter === 'All' || r.dataset.source === filter)));
    };

    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter ?? 'All')));
    apply('All');
  });
</script>

<style>
  .news-page { justify-content: flex-start; }
  .news-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
    margin-bottom: 48px;
  }
  .news-head__text { display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
  .news-head__side { display: flex; flex-direction: column; gap: 20px; max-width: 420px; }

  .chips { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip {
    padding: 10px 18px;
    border-radius: 100px;
    border: 1px solid var(--border-dark);
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .chip:hover { border-color: var(--on-dark-muted); }
  .chip[aria-pressed='true'] { background: var(--cyan); border-color: var(--cyan); color: var(--ink); }

  .news-top { gap: 20px; }
  .news-top :global([hidden]) { display: none; }
  .news-empty {
    padding: 40px;
    border-radius: 16px;
    background: var(--ink-raised);
    border: 1px solid var(--border-dark);
    color: var(--on-dark-muted);
    font-weight: 600;
  }

  .more { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 64px; align-items: start; }
  .more__head { display: flex; flex-direction: column; gap: 16px; position: sticky; top: calc(var(--nav-h) + 32px); }
  .more__list { border-top: 1px solid var(--border); }
  .more__list li[hidden] { display: none; }
  .more__list a {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto 18px;
    align-items: center;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s;
  }
  .more__list a:hover { color: var(--accent); }
  .more__src { color: var(--muted); }
  .more__title { font-weight: 600; line-height: 1.45; }
  .more__list time { font-size: 13px; color: var(--muted); white-space: nowrap; }

  .attribution { font-size: 13px; line-height: 1.6; color: var(--muted); }
  .attribution-only { padding: 32px 0; }

  @media (max-width: 1000px) {
    .news-head { flex-direction: column; align-items: flex-start; gap: 24px; margin-bottom: 32px; }
    .more { grid-template-columns: 1fr; gap: 32px; }
    .more__head { position: static; }
    .more__list a { grid-template-columns: minmax(0, 1fr) 18px; gap: 6px 16px; }
    .more__src { grid-column: 1 / -1; }
    .more__list time { grid-column: 1; }
    .more__list :global(svg) { grid-row: 2; grid-column: 2; }
  }
</style>
