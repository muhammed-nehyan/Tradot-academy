---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found" noindex>
  <section class="screen screen--hero bg-dark">
    <div class="container"><div class="nf">
      <p class="eyebrow">Error 404</p>
      <h1 class="h1">This page has <em>left the market.</em></h1>
      <p class="lead">The page you're looking for doesn't exist or has moved.</p>
      <div class="nf__ctas">
        <Button href="/">Back to home</Button>
        <Button href="/course" variant="outline-light">See the course</Button>
      </div>
    </div></div>
  </section>
</Base>

<style>
  .nf { display: flex; flex-direction: column; gap: 24px; max-width: 760px; }
  .nf__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
</style>
